# Configuração privada do servidor. Não usar o prefixo NEXT_PUBLIC_.
# A URL inclui /api, sem barra final. Serviço informado para integração.
BACKEND_API_URL=https://hotel-system-management-backend.onrender.com/api
# Backend remoto no Render; não iniciar backend Java local.
FRONTEND_ORIGIN=http://localhost:3000
