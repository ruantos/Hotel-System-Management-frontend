{
  "name": "hotel-management-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "smoke:backend": "node --env-file-if-exists=.env.local scripts/smoke-backend.mjs",
    "validate:demo": "node --env-file-if-exists=.env.local scripts/validate-demo.mjs",
    "check:recovery": "node --env-file-if-exists=.env.local scripts/check-recovery.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "lucide-react": "^0",
    "next": "16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6"
  }
}
